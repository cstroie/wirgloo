[Unit]
Description=wirgloo web IRC client
After=network.target

[Service]
ExecStart=/opt/wirgloo/wirgloo -addr 127.0.0.1:6677
Restart=on-failure
RestartSec=5
DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
